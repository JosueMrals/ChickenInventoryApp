rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =====================================================
    // ⚙ Roles — espeja firestore.rules: custom claim primero (sin lectura
    // extra), con el mismo fallback legacy a users/{uid}.role para tokens
    // pre-migración o usuarios sin backfill. Borrar legacyHasRole() y su
    // llamada cuando los claims estén propagados a todos (ver firestore.rules).
    // =====================================================
    function hasRole(role) {
      return request.auth != null
        && (request.auth.token.get('role', '') == role || legacyHasRole(role));
    }

    function legacyHasRole(role) {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() { return hasRole('admin'); }
    function isVendedor() { return hasRole('vendedor'); }
    function isEntregador() { return hasRole('entregador'); }
    function isBodeguero() { return hasRole('bodeguero'); }
    function isOperativo() { return isAdmin() || isVendedor() || isEntregador() || isBodeguero(); }

    // =====================================================
    // 📷 Fotos de clientes — customers/{customerId}/{fileName}
    // Mismo criterio que la colección customers en firestore.rules:
    // los 4 roles leen, solo admin/vendedor escriben o borran.
    // =====================================================
    match /customers/{customerId}/{fileName} {
      allow read: if isOperativo();
      allow write: if (isAdmin() || isVendedor())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || isVendedor();
    }

    // =====================================================
    // 📄 Fotos de facturas de recepción — goodsReceipts/{fileName}
    // La recepción la registra bodega (o admin), así que ellos suben la foto.
    // Los 4 roles operativos pueden verla (consulta del historial).
    // =====================================================
    match /goodsReceipts/{fileName} {
      allow read: if isOperativo();
      allow write: if (isAdmin() || isBodeguero())
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || isBodeguero();
    }

    // =====================================================
    // 🧾 Fotos de comprobantes de gastos — expenseReceipts/{fileName}
    // Cualquier rol operativo registra sus propios gastos, así que cualquiera
    // sube su comprobante (a diferencia de goodsReceipts, que solo bodega/admin).
    // =====================================================
    // FASE S1.7.1 — S1.7-F2. uploadExpenseReceipt(localUri, uid)
    // (expenseReceiptsService.js) nombra el archivo `${uid}_${timestamp}.jpg`
    // — el uid real del subidor vive en el propio nombre. Los UID de Firebase
    // Auth de este proyecto son alfanuméricos sin '_' (generados por
    // admin.auth().createUser sin uid explícito, ver functions/index.js
    // createUser), así que `fileName.split('_')[0]` aísla ese uid de forma
    // confiable. El único caller real de deleteExpenseReceipt
    // (CreateExpenseScreen.jsx) borra su propia foto recién subida —
    // "cualquier operativo borra cualquier comprobante" era más amplio que
    // ese único uso real.
    match /expenseReceipts/{fileName} {
      allow read: if isOperativo();
      allow write: if isOperativo()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin()
        || (isOperativo() && fileName.split('_')[0] == request.auth.uid);
    }

    // Todo lo demás, denegado por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
